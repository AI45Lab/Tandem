{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tandem:protocol/receipt.schema.json",
  "title": "Tandem Receipt v0.1",
  "description": "环境 → harness 的执行回执。无执行确认（acknowledged 无法判定）时环境侧报错不重放。",
  "type": "object",
  "additionalProperties": false,
  "required": ["returncode", "stdout", "stderr", "kind", "acknowledged"],
  "properties": {
    "returncode": { "type": "integer" },
    "stdout": {
      "type": "string",
      "maxLength": 12000,
      "description": "截尾后的输出（保留末尾），全文落 artifacts 文件并记入 full_output_ref。"
    },
    "stderr": { "type": "string", "maxLength": 12000 },
    "kind": { "enum": ["cli", "gui", "wait"] },
    "acknowledged": { "type": "boolean" },
    "full_output_ref": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "episode 目录内完整输出的文件引用；无全文时为 null。"
    }
  }
}
