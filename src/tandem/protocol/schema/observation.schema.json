{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tandem:protocol/observation.schema.json",
  "title": "Tandem Observation v0.2",
  "description": "环境 → harness 的观察消息。二进制一律文件引用，禁止内嵌（MCP-ready 约束）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "instruction",
    "step_idx",
    "budget",
    "screenshot",
    "accessibility_tree",
    "last_receipt",
    "protocol_version"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "instruction": { "type": "string", "minLength": 1 },
    "step_idx": { "type": "integer", "minimum": 0 },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps_remaining", "wall_seconds_remaining"],
      "properties": {
        "steps_remaining": { "type": "integer", "minimum": 0 },
        "wall_seconds_remaining": { "type": "number", "minimum": 0 }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "captured": {
          "type": "boolean",
          "default": true,
          "description": "false 表示复用了之前某步的截图（上一动作 want_observation=none）。"
        }
      }
    },
    "accessibility_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "source"],
      "properties": {
        "present": { "type": "boolean" },
        "source": {
          "enum": ["vm", "jev", "none"],
          "description": "OSW1 由 VM 内提取，OSW2 由 JEV GPU 服务从截图提取；JEV 降级时 present=false/source=none。"
        },
        "digest": { "type": ["string", "null"], "minLength": 1 },
        "node_count": { "type": ["integer", "null"], "minimum": 0 },
        "path": { "type": ["string", "null"], "minLength": 1 }
      },
      "description": "一致性：present=true ⇒ source∈(vm,jev) 且 digest/node_count 必填；present=false ⇒ 其余字段为 null。"
    },
    "browser_snapshot": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "source"],
          "properties": {
            "present": { "type": "boolean" },
            "source": { "enum": ["cdp", "none"] },
            "digest": { "type": ["string", "null"], "minLength": 1 },
            "node_count": { "type": ["integer", "null"], "minimum": 0 },
            "path": { "type": ["string", "null"], "minLength": 1 }
          },
          "description": "CDP DOM 快照文件引用；不可用时为 null。"
        }
      ]
    },
    "last_receipt": {
      "oneOf": [{ "type": "null" }, { "$ref": "tandem:protocol/receipt.schema.json" }]
    },
    "protocol_version": { "const": "0.2" }
  }
}
