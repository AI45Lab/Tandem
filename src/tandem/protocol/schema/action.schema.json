{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tandem:protocol/action.schema.json",
  "title": "Tandem Action v0.1",
  "description": "harness → 环境的动作消息。计步纪律：gui/cli/wait 各占 1 步，共用 max_steps 预算。",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/gui" },
    { "$ref": "#/$defs/cli" },
    { "$ref": "#/$defs/wait" },
    { "$ref": "#/$defs/finish" },
    { "$ref": "#/$defs/fail" }
  ],
  "$defs": {
    "gui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action_type", "parameters"],
      "properties": {
        "kind": { "const": "gui" },
        "action_type": {
          "enum": [
            "click",
            "double_click",
            "right_click",
            "drag",
            "hotkey",
            "type",
            "scroll",
            "key",
            "mouse_down",
            "mouse_up"
          ],
          "description": "v0.1 暂定集，M1 移植 compile 语义时若有出入以移植结果为准并 bump 版本。"
        },
        "parameters": {
          "type": "object",
          "description": "自由参数（坐标/文本/键名等），由 compile 层解释；值必须是纯 JSON。"
        },
        "target_id": { "type": ["string", "null"], "minLength": 1 },
        "description": { "type": ["string", "null"] }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "timeout_s", "want_observation"],
      "properties": {
        "kind": { "const": "cli" },
        "command": { "type": "string", "minLength": 1 },
        "timeout_s": { "type": "integer", "minimum": 1, "maximum": 120 },
        "want_observation": {
          "enum": ["screenshot", "none"],
          "description": "none 表示跳过本步截图（回执仍返回），用于 CLI 连发时省截图与 a11y 成本。"
        }
      },
      "description": "VM 内 bash -lc 执行，cwd=/home/user。文件系统访问一律经此（cat/ls/find）。"
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "wait" } }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "outputs"],
      "properties": {
        "kind": { "const": "finish" },
        "outputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "VM 内 deliverable 路径，可为空数组。"
        }
      }
    },
    "fail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "fail" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
