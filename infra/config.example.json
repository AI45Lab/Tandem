{
  "harness": {
    "slow_model": {
      "default": "kimi-k3",
      "apis": {
        "kimi-k3": {
          "base_url": "https://your-slow-model-endpoint/v1",
          "api_key": "sk-xxx",
          "model": "kimi-k3",
          "max_tokens": 16384,
          "timeout_seconds": 120,
          "reasoning_effort": "low",
          "direct_api": false
        }
      }
    },
    "fast_model": {
      "default": "jev",
      "apis": {
        "jev": {
          "backend": "jev",
          "endpoint": "",
          "endpoint_file": "/mnt/shared-storage-user/evobox-share-gpfs2/xuyuanxun/shared_resources/sa_cua/services/qwen_jev.json",
          "timeout_seconds": 300
        },
        "kev": {
          "backend": "kev",
          "endpoint": "",
          "endpoint_file": "/mnt/shared-storage-user/evobox-share-gpfs2/xuyuanxun/shared_resources/sa_cua/services/kev.json",
          "timeout_seconds": 300
        }
      },
      "image_stage": {
        "write": "/mnt/shared-storage-user/evobox-share-gpfs2/chenxinquan/tandem_jev_images",
        "read": "/mnt/shared-storage-gpfs2/evobox-share-gpfs2/chenxinquan/tandem_jev_images"
      }
    },
    "route": {
      "policy": "auto",
      "allow_cli": true,
      "cli_timeout_seconds": 90
    },
    "budget": {
      "max_steps": 30,
      "max_wall_seconds": 1800
    }
  },
  "eval": {
    "repo_root": "/mnt/shared-storage-user/adpc-share/chenxinquan/fastslow/tandem",
    "deploy_root": "/mnt/shared-storage-user/adpc-share/chenxinquan/fastslow/tandem-deploy",
    "mounts": [
      {
        "source": "gpfs://gpfs2/evobox-share-gpfs2",
        "target": "/mnt/shared-storage-user/evobox-share-gpfs2"
      },
      {
        "source": "gpfs://gpfs2/adpc-share",
        "target": "/mnt/shared-storage-user/adpc-share"
      }
    ],
    "rjob": {
      "charged_group": "evobox_proxy",
      "private_machine": true,
      "cpu": 4,
      "memory": 16384,
      "gpu": 0,
      "image": "registry.h.pjlab.org.cn/ailab-evobox-evobox_cpu/weavebench:osworld-v2-rjob-openclaw-kimi-tasks-uploadfix-20260701"
    },
    "inner_image": "registry.h.pjlab.org.cn/ailab-evobox-evobox_cpu/weavebench:osworld-v2-inner-osworld-docker-socat-20260712",
    "benchmarks": {
      "osworld1": {
        "root": "/mnt/shared-storage-user/evobox-share-gpfs2/xuyuanxun/shared_resources/sa_cua/benchmarks/osworld1",
        "vm": "/mnt/shared-storage-user/evobox-share-gpfs2/xuyuanxun/shared_resources/sa_cua/vm/osworld1/Ubuntu.qcow2"
      },
      "osworld2": {
        "root": "/mnt/shared-storage-user/evobox-share-gpfs2/xuyuanxun/shared_resources/sa_cua/benchmarks/osworld2",
        "vm": "/mnt/shared-storage-user/evobox-share-gpfs2/xuyuanxun/shared_resources/sa_cua/vm/osworld2/osworld-v2-ubuntu-x86.qcow2",
        "asset_root": "/mnt/shared-storage-user/evobox-share-gpfs2/xuyuanxun/shared_resources/sa_cua/osworld2_0808/assets"
      }
    },
    "registry": {
      "auths": {
        "registry.h.pjlab.org.cn": {
          "auth": "<base64 user:pass>"
        }
      }
    }
  },
  "log": {
    "results_root": "/mnt/shared-storage-user/adpc-share/chenxinquan/fastslow/tandem/rjob_logs",
    "record": {
      "a11y_full": false
    }
  }
}
